# ── Discord ────────────────────────────────────────────────────────────────
DISCORD_TOKEN=
GUILD_ID=1528476753939398850
ROLE_ID=
REQUIRE_ROLE_ID=
VERIFY_CHANNEL_ID=
TICKET_STAFF_ROLE_ID=

# ── Entry rule ─────────────────────────────────────────────────────────────
# Threshold in US dollars, summed across every wallet a member links.
# Counts NATIVE coins only: SOL, ETH (Ethereum/Base/Arbitrum), BNB (BNB Chain).
MIN_USD=1000
# Free spots. 0 = unlimited. Set to 50 to enforce the 50-seat story.
MAX_MEMBERS=100
# Launch gate — flip to true on release day.
VERIFY_OPEN=false

# ── Referral links ─────────────────────────────────────────────────────────
# Shown to members trading on a PC / terminal:
REFERRAL_URL=https://trade.padre.gg/rk/rss
# Shown to members trading on their phone:
FOMO_URL=https://fomo.family/r/RSScabal

# ── Web ────────────────────────────────────────────────────────────────────
# Public https URL of this service.
BASE_URL=http://localhost:3000
PORT=3000
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ── RPCs ───────────────────────────────────────────────────────────────────
# Use a real key (Helius/QuickNode) before a launch — public RPCs are rate-limited.
RPC_URL=https://api.mainnet-beta.solana.com
ETH_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com
BASE_RPC_URL=https://base-rpc.publicnode.com
ARB_RPC_URL=https://arbitrum-one-rpc.publicnode.com

# Optional CoinGecko Pro key. Without it the free endpoint is used,
# with Binance as an automatic fallback.
COINGECKO_API_KEY=

# Serve only the verify page, no Discord — for local styling work.
DRY_RUN=false
